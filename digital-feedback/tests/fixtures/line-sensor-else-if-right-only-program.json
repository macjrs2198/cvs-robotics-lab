        "rear": {
          "mode": "none",
          "longitudinalOffset": 42,
          "spacing": 42
        }
      },
      "trackPoints": [
        { "x": 100, "y": 350 },
        { "x": 140, "y": 280 },
        { "x": 220, "y": 200 },
        { "x": 500, "y": 100 }
      ]
    },
    "contactSwitch": {
